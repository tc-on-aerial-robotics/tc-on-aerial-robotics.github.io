---
import { markdownify } from "@/lib/utils/textConverter";
import { withBasePath } from "@/lib/utils/basePath";
import { Image } from "astro:assets";

const {
  features: { banner },
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="row">
      <div
        class="mb-14 text-center lg:col-6 lg:order-1 lg:mb-0 lg:mt-0 lg:text-left"
      >
        <h1 class="page-title" set:html={markdownify(banner.title)} />
        <p class="mt-6" set:html={markdownify(banner.content)} />
        {
          banner.button.enable && (
            <a class="btn btn-primary mt-6" href={withBasePath(banner.button.link)}>
              {banner.button.label}
            </a>
          )
        }
      </div>
      <div class="lg:col-6 lg:order-2">
        <Image
          class="mx-auto"
          src={withBasePath("/images/features-banner-img.png")}
          width={412}
          height={483}
          alt=""
        />
      </div>
    </div>
  </div>
</section>
