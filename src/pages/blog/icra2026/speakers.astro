---
import Base from "@/layouts/Base.astro";
import Workshop2026 from "@/layouts/Workshop2026.astro";

const title = "AI-Driven Safe Aerial Robotics Workshop at ICRA 2026";
---

<Base title={title} meta_title={`Speakers | ${title}`}>
  <Workshop2026 title={title} active="speakers">
    <h2>AI Paradigms for Safety in Aerial Robotics</h2>
    <ul>
      <li>Daniele Palossi — <em>Embodied AI on Tiny Robots</em></li>
      <li>Elia Kaufmann — <em>Reliable Visual Navigation, Anytime, Anywhere</em></li>
      <li>Nora Ayanian — <em>Collision Avoidance in Aerial Vehicles</em></li>
    </ul>

    <h2>Soft &amp; Morphing Aerial Robotics for Safe Interaction</h2>
    <ul>
      <li>Kevin Chen — <em>Aggressive acrobatics in insect-scale aerial robots via deep-learned model predictive control</em></li>
      <li>Robert Katzschmann — <em>Soft &amp; Morphing Aerial Robotics for Safe Interaction</em></li>
      <li>Moju Zhao — <em>Modular aerial robotics for physical interaction</em></li>
    </ul>

    <h2>Bio-Inspired Intelligence and Generative Design</h2>
    <ul>
      <li>Sophie Armanini — <em>Unlocking the potential of unconventional aerial robots</em></li>
      <li>Barbara Mazzolai — <em>Generative Bio-Inspired Design for Adaptive Morphing Robots</em></li>
      <li>Pakpong Chirarattananon — <em>Bio-Inspired Strategies for Agile and Resilient Miniature Aerial Robotics</em></li>
    </ul>

    <h2>From Safety Research to Deployment</h2>
    <ul>
      <li>Fabrizio Schiano — <em>De-risking Autonomy: Leonardo’s approach to safe and reliable autonomous systems</em></li>
      <li>Vijay Kumar — <em>Toward Physical AI: Autonomy, Collaboration, and Language-Guided Behavior in Robotic Systems</em></li>
      <li>Guido De Croon — <em>Bio-inspired AI for inherently safe, lightweight flying robots</em></li>
      <li>Hyun Lim — <em>Large-Scale Drone Swarm for Aerial Entertainment: Lessons Learned from Hundreds to Thousands of Units</em></li>
    </ul>

    <h2>Ethics &amp; Regulation Panel</h2>
    <ul>
      <li>Suchet Bargoti, Skydo.</li>
      <li>Moiz Khan, PhD, Mathworks.</li>
      <li>Ramón Roche, Executive Director of the Dronecode Foundation.</li>
    </ul>
  </Workshop2026>
</Base>
