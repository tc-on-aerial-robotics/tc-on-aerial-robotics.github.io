---
import Base from "@/layouts/Base.astro";
import Workshop2026 from "@/layouts/Workshop2026.astro";

const title = "AI-Driven Safe Aerial Robotics Workshop at ICRA 2026";
---

<Base title={title} meta_title={`${title} | IEEE RAS TC on Aerial Robotics and UAVs`}>
  <Workshop2026 title={title} active="agenda">
    <table>
      <thead><tr><th>Time</th><th>Program</th></tr></thead>
      <tbody>
        <tr><td>8:30–9:45</td><td><strong>Introduction / AI Paradigms for Safety in Aerial Robotics</strong><br />Chair: Anibal Ollero<br />Embodied AI on Tiny Robots | Daniele Palossi<br />Reliable Visual Navigation, Anytime, Anywhere | Elia Kaufmann<br />Collision Avoidance in Aerial Vehicles | Nora Ayanian</td></tr>
        <tr><td>9:45–10:30</td><td><strong>Contributed papers / Oral presentations</strong></td></tr>
        <tr><td>10:30–11:00</td><td><strong>Coffee Break and poster session</strong></td></tr>
        <tr><td>11:00–12:15</td><td><strong>Soft &amp; Morphing Aerial Robotics for Safe Interaction.</strong><br />Chair: Hyunchul Shim<br />Aggressive acrobatics in insect-scale aerial robots via deep-learned model predictive control | Kevin Chen<br />Soft &amp; Morphing Aerial Robotics for Safe Interaction | Robert Katzschmann<br />Modular aerial robotics for physical interaction | Moju Zhao</td></tr>
        <tr><td>12:15–13:00</td><td><strong>Lunch and Meeting of the IEEE TC Aerial Robotics and Unmanned Aerial Vehicles</strong></td></tr>
        <tr><td>13:00–14:15</td><td><strong>Bio-Inspired Intelligence and Generative Design.</strong><br />Chair: Raphael Zufferey<br />Unlocking the potential of unconventional aerial robots | Sophie Armanini<br />Generative Bio-Inspired Design for Adaptive Morphing Robots | Barbara Mazzolai<br />Bio-Inspired Strategies for Agile and Resilient Miniature Aerial Robotics | Pakpong Chirarattananon</td></tr>
        <tr><td>14:15–15:30</td><td><strong>From Safety Research to Deployment.</strong><br />Chair: Giuseppe Loianno<br />De-risking Autonomy: Leonardo’s approach to safe and reliable autonomous systems | Fabrizio Schiano<br />Toward Physical AI: Autonomy, Collaboration, and Language-Guided Behavior in Robotic Systems | Vijay Kumar<br />Bio-inspired AI for inherently safe, lightweight flying robots | Guido De Croon<br />Large-Scale Drone Swarm for Aerial Entertainment: Lessons Learned from Hundreds to Thousands of Units | Hyun Lim</td></tr>
        <tr><td>15:30–16:00</td><td><strong>Coffee Break and poster session</strong></td></tr>
        <tr><td>16:00–16:45</td><td><strong>Panel: Ethics &amp; Regulation Panel.</strong><br />Chair: run by students (with the help of Marco Tognon)<br />Suchet Bargoti, Skydo.<br />Moiz Khan, PhD, Mathworks.<br />Ramón Roche, Executive Director of the Dronecode Foundation.</td></tr>
        <tr><td>16:45–17:00</td><td><strong>Final Remarks</strong></td></tr>
      </tbody>
    </table>
  </Workshop2026>
</Base>
