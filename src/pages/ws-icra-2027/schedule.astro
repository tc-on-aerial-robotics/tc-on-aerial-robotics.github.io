---
import Workshop2027 from "@/layouts/Workshop2027.astro";

const metaTitle = "ICRA 2027 Workshop: Wake Up, Aerial Robotics | IEEE RAS TC on Aerial Robotics and UAVs";
---

<Workshop2027 meta_title={metaTitle} active="schedule">
  <h2>Tentative Schedule</h2>
  <table>
    <thead><tr><th>Time</th><th>Program</th></tr></thead>
    <tbody>
      <tr><td>8:30–8:40</td><td><strong>Introduction — <em>Are We Still Solving the Right Problems?</em></strong></td></tr>
      <tr><td>8:40–9:35</td><td><strong>From Bespoke Skills to General-Purpose Intelligence</strong></td></tr>
      <tr><td>9:35–10:30</td><td><strong>Rethinking How Aerial Robots Sense</strong></td></tr>
      <tr><td>10:30–11:00</td><td><strong>Coffee Break + Poster Session</strong> (all accepted contributions)</td></tr>
      <tr><td>11:00–11:55</td><td><strong>Embodiment as Intelligence</strong></td></tr>
      <tr><td>11:55–12:25</td><td><strong>IEEE RAS TC Best PhD Thesis Award</strong> — award presentation and invited talk by the recipient</td></tr>
      <tr><td>12:30–14:00</td><td><strong>Lunch</strong></td></tr>
      <tr><td>14:00–15:10</td><td><strong>Beyond the Conventional Flying Machine</strong></td></tr>
      <tr><td>15:10–15:40</td><td><strong>Coffee Break + Poster Session</strong> (continued; best-poster voting)</td></tr>
      <tr><td>15:40–16:20</td><td><strong>Industry &amp; Startup Panel: <em>What does aerial robotics still need?</em></strong></td></tr>
      <tr><td>16:20–17:10</td><td><strong>Interactive Grand-Challenges Discussion: <em>What should we work on next?</em></strong></td></tr>
      <tr><td>17:10–17:30</td><td><strong>Synthesis, Best-Poster Award, and Closing</strong></td></tr>
      <tr><td>Evening</td><td><strong>Informal Networking Gathering</strong> supported by the IEEE RAS TC</td></tr>
    </tbody>
  </table>
</Workshop2027>
